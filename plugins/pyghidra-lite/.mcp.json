{
  "mcpServers": {
    "pyghidra-lite": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "pyghidra-lite==0.9.0", "pyghidra-lite", "serve"],
      "env": {
        "GHIDRA_INSTALL_DIR": "${user_config.ghidra_install_dir}",
        "PYGHIDRA_LITE_PROJECT_DIR": "${user_config.project_dir}",
        "PYGHIDRA_LITE_RESTRICT_PATHS": "${user_config.restrict_paths}",
        "PYGHIDRA_LITE_ALLOW_WRITE": "${user_config.allow_write}"
      }
    }
  }
}
