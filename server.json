{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.johnzfitch/pyghidra-lite",
  "description": "Token-efficient Ghidra RE: decompile, xrefs, Swift/ObjC, ELF/Mach-O, async analysis",
  "repository": {
    "url": "https://github.com/johnzfitch/pyghidra-lite",
    "source": "github"
  },
  "version": "0.6.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "pyghidra-lite",
      "version": "0.6.0",
      "transport": {
        "type": "stdio",
        "args": []
      },
      "runtimeHint": "python",
      "environmentVariables": [
        {
          "name": "GHIDRA_INSTALL_DIR",
          "description": "Path to Ghidra installation directory",
          "isRequired": false
        }
      ]
    }
  ]
}
